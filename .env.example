# Aethra Finance environment variables

# The MVP is non-custodial. Do not add deployer private keys, trading keys,
# transaction executors, bridge endpoints, or token issuance settings here.

# ---- Optional public data sources ----
DEFILLAMA_API_BASE=https://yields.llama.fi
COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# ---- Optional app settings ----
APP_ENV=development
DATA_CACHE_TTL_SECONDS=900
